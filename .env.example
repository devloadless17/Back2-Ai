# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Port 5442 (not 5432) so the dev container never collides with another local
# Postgres. Must match the published port in docker-compose.yml.
DATABASE_URL="postgresql://bac2:bac2_local_dev@localhost:5442/bac2?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE_ME_generate_a_real_secret"
# Session lifetime in days. Sessions are server-side and revocable.
SESSION_TTL_DAYS=14

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "anthropic" | "openai" — selects which real client backs every AI call
# (chat, generation, grading, verification). Both are fully implemented.
AI_PROVIDER="openai"

# Three jobs, three settings — see the block comment in src/lib/env.ts.
#   MODEL         writes the answer the student reads.
#   MODEL_VERIFY  marks work and checks an answer against its sources.
#   MODEL_FAST    plumbing: query translation, topic keywords, reranking.
# MODEL_FAST is never shown to a student and every call site using it fails
# open, so it should be the cheapest adequate model. Do NOT leave it pointing at
# MODEL_VERIFY: that setting is chosen for correctness at the last gate before a
# wrong answer reaches someone sitting an exam, and on the Anthropic config it
# is the most expensive model in the price table.

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Used for grading and solution verification. Same model by default — for an
# official examination product, marking should not run on a weaker model than
# tutoring. Point this at a cheaper model only as a deliberate cost decision.
ANTHROPIC_MODEL_VERIFY="claude-opus-5"
ANTHROPIC_MODEL_FAST="claude-sonnet-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"
OPENAI_MODEL_VERIFY="gpt-5.4-mini"
OPENAI_MODEL_FAST="gpt-5.4-mini"

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "openai" | "voyage" | "local". Dimension MUST match the vector(N) column width
# in the database. Changing either one requires: npm run vector:resize
#
#   openai  text-embedding-3-small, 1536 — needs OPENAI_API_KEY. About $0.10
#           to embed this whole corpus. Separates a real question from an
#           off-syllabus one by ~0.17, which is what makes the refusal tier
#           dependable. This is what the project runs on.
#   voyage  voyage-3, 1024 — needs VOYAGE_API_KEY, strongest on Arabic
#   local   Xenova/multilingual-e5-base, 768 — no key, no cost, CPU only.
#           Downloads the model on first use and embeds this corpus in a couple
#           of hours. Its similarity scores sit in a much narrower band than the
#           hosted models, so run `npm run calibrate` and set the thresholds in
#           src/lib/retrieval.ts to what it measures. Reusing the hosted
#           thresholds here makes every tier fire on everything.
#           The e5-small variant is three times faster and ranks noticeably
#           worse (30/40 against 34/40 on this corpus); mpnet ranks worse still.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
VOYAGE_API_KEY=""

# ---------------------------------------------------------------------------
# OCR (handwritten answer photos + ingestion of scanned past papers)
# ---------------------------------------------------------------------------
# "vision" uses the configured AI provider's multimodal model. Swap to a
# dedicated document-AI service by adding a driver in src/lib/ocr/.
OCR_PROVIDER="vision"

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO in dev, S3/R2 in production)
# ---------------------------------------------------------------------------
# Which driver src/lib/storage.ts uses. Anything other than "s3" writes to
# ./uploads on the local filesystem, which is the dev default and is wrong
# anywhere the disk is read-only or per-instance — a serverless host will accept
# the write into its own ephemeral /tmp and lose the file on the next request.
# Set this to "s3" in production; the driver also requires S3_ACCESS_KEY_ID and
# an http(s) S3_ENDPOINT before it will switch over.
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="bac2"
S3_ACCESS_KEY_ID="bac2minio"
S3_SECRET_ACCESS_KEY="bac2_local_dev"
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="en"
# Secret required by cron-triggered route handlers (batch generation,
# difficulty recalibration, readiness recompute).
CRON_SECRET="CHANGE_ME_cron_secret"

# ---------------------------------------------------------------------------
# Reminders
# ---------------------------------------------------------------------------
# Email. Left empty, every message is written to the server log instead of
# being sent, so signup, password reset and the nightly reminder can all be
# walked through without a mail account.
RESEND_API_KEY=""
# Web push. Generate a pair with `npx web-push generate-vapid-keys`; the public
# half is served to the browser, the private half never leaves the server. Left
# empty, push is skipped and email still goes out.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@bac2.local"
