# Ingestion working directory — real exam PDFs and answer keys must never be committed.
/corpus/
/uploads/

# Stray corpus output from a run with a relative OUT_DIR.
scripts/corpus/corpus/
__pycache__/
*.pyc
.vercel
.env*
# ...but the *templates* are documentation and must ship. They hold no real
# values, and `.env*` above would otherwise swallow every one of them — which is
# how deploy/.env.example silently failed to be committed the first time.
!.env.example
!**/.env.example

# Personal working notes, not product documentation.
# Launch checklists, status updates for management, anything holding a
# credential or a connection string. These live on the machine, never in the
# repository — LAUNCH-PLAN.md carried the production admin password into git
# history before this rule existed.
LAUNCH-PLAN.md
UPDATE-*.md
NOTES.md
*-credentials.md

# Internal audits, handover notes and planning documents. The README is the
# only documentation this repository ships; everything else was a working
# artefact for one person and goes stale the week it is written.
/docs/
*-AUDIT.md
*_AUDIT.md
HANDOVER.md
PRODUCTION-RUNBOOK.md
LAUNCH-QA.md
SYSTEM-BRIEF.md
NOUR-VERIFICATION-DEBT.md
