# Production environment for the compose stack. Lives on the VPS at
# /home/deploy/bac2ai/.env, chmod 600, rendered by the deploy job in
# .github/workflows/ci.yml from GitHub secrets. This file is the reference for
# what that job writes — it is NOT copied to the server.
#
# Compose reads this file twice: once to interpolate ${...} in
# docker-compose.prod.yml, and once as the env_file handed to every container.
# One file, one copy of each secret, and the same file the ops container mounts
# at /app/.env so `node --env-file=.env` finds something.
#
# NO APOSTROPHES AND NO `$` IN ANY VALUE. Compose's env parser is not a shell:
# it has no escape inside single quotes, and it expands $VAR in unquoted values,
# silently truncating a secret at the first `$`. Generate with
# `openssl rand -hex 32` or `openssl rand -base64 48` — neither emits either.

# ---- compose interpolation --------------------------------------------------
# The git SHA of the release. This is the rollback unit: put a previous SHA here
# and `up -d`, no rebuild.
IMAGE_TAG=
DOCKER_USERNAME=
SITE_DOMAIN=backai.loadless.site
ACME_EMAIL=

# ---- dockerized postgres ----------------------------------------------------
POSTGRES_USER=bac2
# HEX, not base64. This is interpolated raw into DATABASE_URL below, and `/ @ :
# ? #` would split the URL's authority section — producing a valid-LOOKING URL
# that points somewhere else, so Prisma reports a confusing host error rather
# than a bad password. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=bac2

# ---- application ------------------------------------------------------------
NODE_ENV=production
# Host is the compose service name and the INTERNAL port. Not localhost:5442 —
# that is the dev compose file's published port and means nothing here.
DATABASE_URL=postgresql://bac2:SAME_AS_POSTGRES_PASSWORD@db:5432/bac2?schema=public
# openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=14
# The real origin, https, NO trailing slash. Builds the absolute links in
# password-reset and verify-email messages; wrong here means unusable links.
APP_URL=https://backai.loadless.site
DEFAULT_LOCALE=en
# openssl rand -hex 32. Empty makes /api/cron return 503 for everything, so
# expired papers are never auto-submitted and no reminders send.
CRON_SECRET=

# ---- AI ---------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_VERIFY=gpt-5.4-mini
ANTHROPIC_API_KEY=
# Needed even when AI_PROVIDER=anthropic: isAiConfigured() and
# isEmbeddingConfigured() are separate checks, and failing only the second boots
# fine and then refuses every retrieval — which reads like a corpus problem.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# MUST equal the vector(N) width in the database. Verify against the restored
# data, do not assume: scripts/resize-embeddings.ts exists because it can have
# been changed.
EMBEDDING_DIM=1536

# ---- object storage: Cloudflare R2 ------------------------------------------
# EXACTLY "s3". Compared as a raw string, outside the zod schema.
STORAGE_DRIVER=s3
# Account id only. No bucket, no path, NO TRAILING SLASH.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=back-ai-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# REQUIRED true for R2 — see .env.example at the repo root for why.
S3_FORCE_PATH_STYLE=true

# ---- mail and push ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Bac II <no-reply@backai.loadless.site>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@loadless.ai

# ---- AI spend ceilings, per user per month, in dollars ----------------------
AI_BUDGET_FREE_USD=1
AI_BUDGET_MONTHLY_USD=10
AI_BUDGET_ANNUAL_USD=10
