{
  "name": "bac2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --conditions=react-server --env-file=.env --import tsx prisma/seed.ts",
    "db:seed:taxonomy": "node --conditions=react-server --env-file=.env --import tsx prisma/seed-taxonomy.ts",
    "db:reset": "prisma migrate reset --force",
    "vector:resize": "node --conditions=react-server --env-file=.env --import tsx scripts/resize-embeddings.ts",
    "ingest": "node --conditions=react-server --env-file=.env --import tsx scripts/ingest.ts",
    "eval": "node --conditions=react-server --env-file=.env --import tsx scripts/eval.ts",
    "corpus:ocr": "node --env-file=.env --import tsx scripts/corpus/docai.ts",
    "corpus:mathpix": "node --env-file=.env --import tsx scripts/corpus/mathpix.ts",
    "corpus:gates": "node --env-file=.env --import tsx scripts/corpus/gates.ts",
    "corpus:katex": "node scripts/corpus/katex-check.mjs",
    "cron": "node --conditions=react-server --env-file=.env --import tsx scripts/cron.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  },
  "prisma": {
    "seed": "node --conditions=react-server --env-file=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "katex": "^0.16.11",
    "next": "^15.1.6",
    "openai": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@google-cloud/documentai": "^9.6.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
