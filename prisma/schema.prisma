// ---------------------------------------------------------------------------
// Bac II AI system — database schema
//
// Mapping notes for reviewers comparing this against the SQL in the exec plan:
//   * Table and column names are pinned to the plan's snake_case via @@map/@map.
//   * The plan's `TEXT` status columns are modelled as native Postgres enums.
//     A system used for official examinations should reject an invalid status
//     at the database, not discover it at read time.
//   * `vector` columns are `Unsupported` — Prisma has no vector type. They are
//     created by migration and read/written through raw SQL in src/lib/vector.
//     Width is pinned to EMBEDDING_DIM; see scripts/resize-embeddings.ts.
//   * Tables marked "ADDITION" are not in the exec plan but are required for a
//     feature the plan does specify. Each says which one.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  student
  admin

  @@map("role")
}

enum Language {
  fr
  en
  ar

  @@map("language")
}

enum SourceType {
  past_exam
  textbook
  generated

  @@map("source_type")
}

enum QuestionType {
  mcq
  open
  problem

  @@map("question_type")
}

enum VerifiedStatus {
  unverified
  verified
  rejected

  @@map("verified_status")
}

enum VerificationStatus {
  pending
  solver_passed
  solver_failed
  approved
  rejected

  @@map("verification_status")
}

enum ExamSourceMode {
  /// One official paper, sat as it was printed.
  real_cycle
  /// Model-written problems, each approved through the review queue first.
  ai_generated
  /// A mock paper assembled from real past-exam questions the student has not
  /// met, drawn across chapters. No model writes anything and nothing needs
  /// approving — every question already came off an official paper.
  real_mixed

  @@map("exam_source_mode")
}

enum ExamSimStatus {
  in_progress
  submitted
  graded

  @@map("exam_sim_status")
}

enum SubmissionType {
  typed
  photo

  @@map("submission_type")
}

/// Which surface produced an attempt. Old-cycle "hover to reveal" mode is
/// deliberately absent: that mode must never write an attempt row, because it
/// is unscored and would otherwise poison mastery.
enum AttemptContext {
  practice
  quiz
  exam_sim

  @@map("attempt_context")
}

enum ChatRole {
  user
  assistant

  @@map("chat_role")
}

/// Billing plan. `free` is a real row rather than the absence of one, so that
/// "this student has never been asked to pay" and "this student's card failed"
/// are distinguishable states.
enum SubscriptionPlan {
  free
  monthly
  annual

  @@map("subscription_plan")
}

/// `pending` is the state every account starts in while no payment processor is
/// connected: a card has been described but nothing has been charged and no
/// entitlement has been granted by a provider.
enum SubscriptionStatus {
  pending
  active
  past_due
  canceled

  @@map("subscription_status")
}

/// Ordered retrieval tiers. `ungrounded_refused` is a first-class outcome, not
/// an error: when nothing clears threshold the system says so rather than guess.
enum GroundingTier {
  exact_match
  concept_level
  personal_reference
  ungrounded_refused

  /// The message was not a curriculum question, so no grounding was owed.
  ///
  /// "hello" used to be answered with "This isn't covered by the material
  /// available for your track" — a claim about the syllabus, made about a
  /// message that asked nothing about the syllabus. This tier keeps that lane
  /// separate so the UI can stay quiet instead of badging a greeting as
  /// off-programme, and so refusal rates measure refusals rather than hellos.
  conversational

  /// Answered from the model's own knowledge, with no material behind it.
  ///
  /// The corpus does not yet cover most of what a candidate will ask, and a
  /// refusal is only the honest answer when the claim being refused is "this is
  /// off your programme". For everything else it was the product declining to
  /// help with something it knows perfectly well.
  ///
  /// The bargain: the answer is given, and it is *labelled* — the student is
  /// told plainly that this one is not from their textbook, so they know which
  /// answers they can quote to a teacher and which they cannot. Kept as its own
  /// tier so grounded and ungrounded answers never blend in the numbers.
  general_knowledge

  /// Answered from this student's own schedule, mastery and exam dates.
  ///
  /// "Am I behind?" has no answer in any textbook, so the curriculum path could
  /// only ever refuse it — and once general knowledge existed, could only
  /// answer it generically under a notice saying it was not from their
  /// material. Both misdescribe where the answer actually lives.
  ///
  /// Separate from `personal_reference`, which means the documents a student
  /// uploaded. This one is the record the product itself keeps about them, and
  /// it is the only tier whose facts the product can state without qualifying
  /// them at all: it is not recalling this data, it is holding it.
  study_record

  @@map("grounding_tier")
}

enum StudySessionSource {
  manual
  ai_suggested

  @@map("study_session_source")
}

/// What a planned session actually asks the student to do. A plan made only of
/// "study this chapter" blocks is a to-do list; naming the activity is what
/// makes it a plan.
enum StudySessionTaskType {
  quiz
  flashcards
  exam_drill
  review

  @@map("study_session_task_type")
}

enum StudySessionStatus {
  planned
  done
  skipped

  @@map("study_session_status")
}

enum ReviewItemType {
  generated_problem
  tagged_question
  flagged_content
  /// A revision card written from the textbook. Unlike a generated problem
  /// these are dealt to the student immediately and reviewed afterwards — see
  /// `GeneratedCard` for why that trade is acceptable for a card and would not
  /// be for a question.
  generated_flashcard

  @@map("review_item_type")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

enum NotificationType {
  flashcards_due
  schedule_reminder
  announcement

  @@map("notification_type")
}

enum IngestionJobStatus {
  queued
  running
  succeeded
  failed

  @@map("ingestion_job_status")
}

/// Kind of concept-level material in the RAG corpus. Drives how tier-2
/// retrieval results are framed in a grounded answer.
enum ContentChunkKind {
  definition
  formula
  theorem
  method
  worked_example

  @@map("content_chunk_kind")
}

enum LinkedAction {
  quiz
  flashcards
  practice
  exam_sim

  @@map("linked_action")
}

// ===========================================================================
// Taxonomy
// ===========================================================================

model Track {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String

  subjects      Subject[]
  users         User[]
  announcements Announcement[]

  @@map("tracks")
}

model Subject {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId  String?  @map("track_id") @db.Uuid
  name     String
  language Language
  /// The similarity a question must reach before this subject answers it.
  ///
  /// Null means the language default (0.50 Latin, 0.45 Arabic). Set only by
  /// scripts/calibrate-subject-gates.ts, which measures the questions a subject
  /// must answer against the questions it must refuse and moves the gate only
  /// where those two populations separate. Re-calibrate after re-chunking.
  conceptGate Float? @map("concept_gate")

  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  units           Unit[]
  chapters        Chapter[]
  examCycles      ExamCycle[]
  examSimulations ExamSimulation[]
  readinessScores ReadinessScore[]
  userGrades      UserGrade[]
  upcomingExams   UpcomingExam[]
  announcements   Announcement[]
  ingestionJobs   IngestionJob[]
  chatSessions    ChatSession[]

  @@index([trackId])
  @@map("subjects")
}

/// ADDITION — the book a question or chunk came from.
///
/// The product may only say things it can trace to real curriculum material,
/// and "traceable" has to survive a challenge from a teacher: which book, which
/// edition, which page. A filename in a text column cannot do that.
///
/// One row per physical book, keyed by the SHA-256 of the source PDF, so the
/// same book imported twice under different names is still one row.
model SourceDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sha256         String    @unique
  bookKey        String    @unique @map("book_key")
  title          String
  publisher      String?
  language       Language
  /// Tracks this book serves. Several books serve two: chemistry and physics
  /// are shared by GS and LS, and three books are shared by LH and SE.
  tracks         String[]
  subjectName    String    @map("subject_name")
  pageCount      Int       @map("page_count")
  firstPublished Int?      @map("first_published")
  impression     Int?
  sourceUrl      String?   @map("source_url")
  retrievedAt    DateTime? @map("retrieved_at") @db.Date
  licenceNote    String?   @map("licence_note")
  reader         String?
  storageKey     String?   @map("storage_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  questions     Question[]
  contentChunks ContentChunk[]

  @@map("source_documents")
}

model Unit {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId  String @map("subject_id") @db.Uuid
  name       String
  orderIndex Int    @map("order_index")

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([subjectId, orderIndex])
  @@map("units")
}

model Chapter {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId  String  @map("subject_id") @db.Uuid
  unitId     String? @map("unit_id") @db.Uuid
  name       String
  orderIndex Int     @map("order_index")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit    Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  questions         Question[]
  generatedProblems GeneratedProblem[]
  generatedCards    GeneratedCard[]
  contentChunks     ChapterContentChunk[]
  chapterMastery    ChapterMastery[]
  studySessions     StudySession[]
  todos             Todo[]

  attempts         Attempt[]
  alsoHasQuestions QuestionChapter[]

  @@unique([subjectId, orderIndex])
  @@index([unitId])
  @@map("chapters")
}

// ===========================================================================
// Users, sessions, audit
// ===========================================================================

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              Role      @default(student)
  /// Locked at signup. Changing it is an admin-only, audit-logged action.
  trackId           String?   @map("track_id") @db.Uuid
  /// Locked at signup, same policy as trackId.
  preferredLanguage Language  @map("preferred_language")
  /// ISO 3166-1 alpha-2. Only countries whose curriculum has been ingested are
  /// selectable at signup; the column is wider than that on purpose, so opening
  /// a second country is a data change rather than a migration.
  country           String    @default("LB") @db.Char(2)
  displayName       String?   @map("display_name")
  /// What this student calls their tutor. Null means they have not named it and
  /// the locale's default is shown. It lives on the account rather than in the
  /// browser because the point of naming it is that it is *theirs* — a name that
  /// vanished when they opened the app on the school computer would say the
  /// opposite of what naming it is for.
  tutorName         String?   @map("tutor_name")
  /// Null until the address has been confirmed. Login refuses while it is null,
  /// so this column is the gate rather than a decoration on the profile page.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Reminder delivery, per student. Both default on: a student who signs up for
  /// a revision planner has asked to be reminded, and burying that behind a
  /// settings page they never open makes the planner useless to them.
  emailReminders    Boolean   @default(true) @map("email_reminders")
  pushReminders     Boolean   @default(true) @map("push_reminders")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  sessions          Session[]
  attempts          Attempt[]
  chapterMastery    ChapterMastery[]
  flashcardState    FlashcardState[]
  readinessScores   ReadinessScore[]
  chatSessions      ChatSession[]
  userReferences    UserReference[]
  userGrades        UserGrade[]
  studySessions     StudySession[]
  upcomingExams     UpcomingExam[]
  todos             Todo[]
  examSimulations   ExamSimulation[]
  notifications     Notification[]
  announcements     Announcement[]     @relation("AnnouncementAuthor")
  flaggedItems      ReviewQueueItem[]  @relation("ReviewFlagger")
  reviewedItems     ReviewQueueItem[]  @relation("ReviewResolver")
  auditEvents       AuditEvent[]
  ingestionJobs     IngestionJob[]
  subscription      Subscription?
  generatedCards    GeneratedCard[]
  authTokens        AuthToken[]
  pushSubscriptions PushSubscription[]

  aiUsage AiUsage[]

  @@index([trackId])
  @@map("users")
}

/// A single-use link sent to an email address.
///
/// One table for both purposes rather than two near-identical ones: they have
/// the same lifecycle — issued, emailed, used once, expired — and the same two
/// ways of being dangerous. Only the hash is stored, for the same reason session
/// tokens are hashed: a leaked database should not hand over working links to
/// reset every account's password.
/// The other chapters an exercise also belongs to.
///
/// A Lebanese exam exercise is deliberately cross-topic: a chemistry question
/// asks about an alcohol, its oxidation to an aldehyde, and the carboxylic acid
/// that follows — three consecutive chapters, one exercise. `questions.chapter_id`
/// can hold only one of them, so the other two chapters never offer it, and a
/// student revising aldehydes never sees a question that is half about aldehydes.
///
/// Measured on GS Chemistry: 41% of exercises have no single best chapter, and
/// every mis-filing is a swap between adjacent organic chapters at margins of
/// 0.03. That is not a filing error to correct, it is one chapter being asked to
/// hold something that belongs to several.
///
/// `questions.chapter_id` stays, and stays authoritative for mastery: credit for
/// answering has to land somewhere definite, and splitting it across three
/// chapters would make every mastery figure a fraction of an attempt. This table
/// answers a different question — which chapters may OFFER this exercise.
model QuestionChapter {
  questionId String @map("question_id") @db.Uuid
  chapterId  String @map("chapter_id") @db.Uuid
  /// How close this chapter scored to the winner when the link was made. Kept so
  /// a later pass can raise the bar without re-embedding everything.
  score      Float?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chapter  Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([questionId, chapterId])
  @@index([chapterId])
  @@map("question_chapters")
}

model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  /// SHA-256 of the token that was emailed. The token itself is never stored.
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  /// Set the moment it is redeemed, so a link in a forwarded email is inert.
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

enum AuthTokenPurpose {
  email_verify
  password_reset

  @@map("auth_token_purpose")
}

/// One browser that has agreed to receive push.
///
/// Keyed by endpoint, which is what the push service issues and what identifies
/// the browser — a student with a laptop and a phone has two rows, and deleting
/// one must not silence the other. Rows are removed when the push service
/// answers 404 or 410, which is how it says a subscription is dead; keeping them
/// means every future send retries a browser that has been uninstalled.
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// ADDITION — the account's billing state.
///
/// No payment processor is connected yet. This table deliberately holds only
/// what a processor would hand back afterwards (brand, last four, expiry) plus
/// the ids it will key on. It must never hold a full card number, a CVC, or
/// anything else that would put this database in PCI scope: the API layer
/// refuses those fields rather than storing them, so wiring a real processor
/// later is an addition to this table, not a cleanup of it.
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  plan                   SubscriptionPlan   @default(free)
  /// An administrator's ceiling for THIS student, in micro-dollars.
  ///
  /// Null means the plan's ceiling applies, which is what every account gets
  /// until somebody decides otherwise. Clearing it restores the plan default
  /// rather than setting zero — a zero would silently stop the student working.
  aiBudgetMicros         BigInt?            @map("ai_budget_micros")
  status                 SubscriptionStatus @default(pending)
  /// Which processor issued the ids below. Null until one is connected.
  provider               String?
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  cardBrand              String?            @map("card_brand")
  cardLast4              String?            @map("card_last4") @db.Char(4)
  cardExpMonth           Int?               @map("card_exp_month")
  cardExpYear            Int?               @map("card_exp_year")
  cardholderName         String?            @map("cardholder_name")
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// ADDITION — supports server-side session revocation, which the exec plan's
/// NextAuth/JWT approach cannot do. An examination system must be able to kill
/// a live session immediately (compromised account, invigilator intervention).
/// Only the SHA-256 of the token is stored; the raw token exists solely in the
/// user's httpOnly cookie.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// ADDITION — append-only audit trail. Required for the exec plan's own rules:
/// "admin edits a student's locked track/language", "generated content
/// publication stays admin-gated", "that should be an explicit, logged config
/// change". None of those are enforceable without a log.
model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ===========================================================================
// Content: real questions
// ===========================================================================

/// One printed paper.
///
/// `language` is the edition, and it is not the same thing as the subject's
/// language. The sciences are taught in French or English and have a subject
/// per language, so for them the two always agree. The humanities are taught in
/// Arabic — there is one `فلسفة عامة` and a French-track student is shown it,
/// because `subjectLanguagesFor` returns `['fr', 'ar']` — but the CRDP prints
/// the philosophy paper in all three languages.
///
/// Without this column those three editions collided on
/// `(subjectId, year, session)` and became one cycle. Measured before it
/// existed: 254 of 1,088 cycles held more than one language, and a student
/// opening "Philosophie LH 2018" was shown the Arabic, French and English
/// papers stacked together as if they were one 58-question exam.
model ExamCycle {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  year            Int
  session         String?
  /// Which printed edition. Defaults to the subject's own language, which is
  /// correct for every subject that only ever had one.
  language        Language @default(ar)
  title           String
  /// ADDITION — the exam-sim timer needs an authoritative duration, and a real
  /// cycle's duration is a property of the paper, not of the student's run.
  durationMinutes Int      @default(180) @map("duration_minutes")

  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       Question[]
  examSimulations ExamSimulation[]

  @@unique([subjectId, year, session, language])
  @@index([subjectId, year])
  @@map("exam_cycles")
}

model Question {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId             String         @map("chapter_id") @db.Uuid
  sourceType            SourceType     @map("source_type")
  sourceExamId          String?        @map("source_exam_id") @db.Uuid
  /// Which paper, which exercise, which part. Stable across re-extraction,
  /// so improving the parser updates a question instead of shadowing it.
  sourceRef             String?        @unique @map("source_ref")
  questionType          QuestionType   @map("question_type")
  /// 0.00–1.00. Recalibrated from observed attempt data by the nightly job.
  difficulty            Decimal?       @db.Decimal(3, 2)
  difficultyConfidence  Decimal?       @map("difficulty_confidence") @db.Decimal(3, 2)
  contentText           String         @map("content_text")
  contentLatex          String?        @map("content_latex")
  /// Folded copy of the statement, maintained by Postgres, for the term index.
  searchText            String?        @default(dbgenerated()) @map("search_text")
  contentImages         String[]       @map("content_images")
  /// The text printed on the exam paper that this question is asked about.
  ///
  /// A comprehension question — "identifiez le référent du pronom « on » dans
  /// les deux premiers paragraphes" — has its answer in a passage that exists
  /// on the paper and in no chapter of any book. Without this the tutor can
  /// only ask the student to type the extract in. It belongs to the question
  /// rather than to the chapter because that is where it is true: the same
  /// chapter serves a hundred papers with a hundred different extracts.
  sourcePassage         String?        @map("source_passage")
  /// ADDITION — question_type 'mcq' is in the plan but the plan stores nowhere
  /// to put the choices. Shape: [{ id, text, latex? }]. Null for open/problem.
  options               Json?
  /// ADDITION — the option id that is correct, for mcq auto-grading.
  correctOptionId       String?        @map("correct_option_id")
  officialSolution      String?        @map("official_solution")
  officialSolutionLatex String?        @map("official_solution_latex")
  /// Structured point breakdown: [{ criterion, points }]
  bareme                Json?
  /// Position within its source paper; drives ordering in old-cycle mode.
  orderIndex            Int?           @map("order_index")
  verifiedStatus        VerifiedStatus @default(unverified) @map("verified_status")
  /// ADDITION — where this came from, down to the page.
  sourceDocumentId      String?        @map("source_document_id") @db.Uuid
  sourcePageFrom        Int?           @map("source_page_from")
  sourcePageTo          Int?           @map("source_page_to")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // vector(EMBEDDING_DIM) — created by migration, accessed via raw SQL only.
  embedding Unsupported("vector(1536)")?

  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceExam     ExamCycle?      @relation(fields: [sourceExamId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  attempts         Attempt[]
  flashcardState   FlashcardState[]
  chatSessions     ChatSession[]
  examSimQuestions ExamSimulationQuestion[]
  alsoInChapters   QuestionChapter[]

  @@index([chapterId, difficulty])
  @@index([sourceExamId, orderIndex])
  @@index([verifiedStatus])
  @@map("questions")
}

/// ADDITION — tier 2 of the retrieval pipeline ("chapter-level textbook
/// content: formulas/methods/worked examples") has no table in the exec plan.
/// Without it, tier 2 can never fire and every non-exact-match question falls
/// straight to "not covered". This is that corpus.
model ContentChunk {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             ContentChunkKind
  title            String?
  contentText      String           @map("content_text")
  contentLatex     String?          @map("content_latex")
  /// Folded copy of title + text, maintained by Postgres, for the term index.
  /// Never written by the application: GENERATED ALWAYS AS ... STORED.
  searchText       String?          @default(dbgenerated()) @map("search_text")
  sourceRef        String?          @map("source_ref")
  /// ADDITION — where this came from, down to the page.
  sourceDocumentId String?          @map("source_document_id") @db.Uuid
  sourcePageFrom   Int?             @map("source_page_from")
  sourcePageTo     Int?             @map("source_page_to")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  embedding Unsupported("vector(1536)")?

  sourceDocument SourceDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  chapters       ChapterContentChunk[]
  generatedCards GeneratedCard[]

  @@index([kind])
  @@map("content_chunks")
}

/// A passage and the chapters that teach it.
///
/// Four tracks share textbooks — civics is on all four syllabuses, maths on
/// three — and a subject row exists per track so that mastery, exam cycles and
/// track scoping stay separate. Filing the text once per chapter therefore
/// stored the civics book four times: 15,668 rows for 11,063 distinct passages.
///
/// The passage is now stored once and pointed at from every chapter that uses
/// it. Nothing about retrieval changes: a search is still scoped to the
/// student's own subjects, so a GS student reaches a shared passage through the
/// GS chapter and never sees the LS one.
model ChapterContentChunk {
  chapterId String @map("chapter_id") @db.Uuid
  chunkId   String @map("chunk_id") @db.Uuid

  chapter Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chunk   ContentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chapterId, chunkId])
  @@index([chunkId])
  @@map("chapter_content_chunks")
}

model GeneratedProblem {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId          String             @map("chapter_id") @db.Uuid
  styleReferenceIds  String[]           @map("style_reference_ids") @db.Uuid
  contentText        String             @map("content_text")
  contentLatex       String?            @map("content_latex")
  generatedSolution  String             @map("generated_solution")
  bareme             Json?
  finalAnswer        String             @map("final_answer")
  difficulty         Decimal?           @db.Decimal(3, 2)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verificationNotes  String?            @map("verification_notes")
  modelUsed          String?            @map("model_used")
  promptVersion      String?            @map("prompt_version")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Non-null only after review-queue approval. Nothing student-facing may
  /// select a generated problem with published_at IS NULL.
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(6)

  embedding Unsupported("vector(1536)")?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  attempts         Attempt[]
  examSimQuestions ExamSimulationQuestion[]

  @@index([chapterId, verificationStatus])
  @@index([publishedAt])
  @@map("generated_problems")
}

// ===========================================================================
// Exam simulations
// ===========================================================================

model ExamSimulation {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  subjectId       String         @map("subject_id") @db.Uuid
  sourceMode      ExamSourceMode @map("source_mode")
  examCycleId     String?        @map("exam_cycle_id") @db.Uuid
  status          ExamSimStatus  @default(in_progress)
  durationMinutes Int            @map("duration_minutes")
  /// ADDITION — server-authoritative deadline. The client countdown is display
  /// only; submission is validated against this column. A client-trusted timer
  /// is not acceptable for an examination product.
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  totalScore      Decimal?       @map("total_score") @db.Decimal(6, 2)
  maxScore        Decimal?       @map("max_score") @db.Decimal(6, 2)
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(6)
  gradedAt        DateTime?      @map("graded_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examCycle ExamCycle? @relation(fields: [examCycleId], references: [id], onDelete: SetNull)

  questions ExamSimulationQuestion[]

  @@index([userId, startedAt])
  @@index([status])
  @@map("exam_simulations")
}

model ExamSimulationQuestion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examSimulationId   String   @map("exam_simulation_id") @db.Uuid
  questionId         String?  @map("question_id") @db.Uuid
  generatedProblemId String?  @map("generated_problem_id") @db.Uuid
  orderIndex         Int      @map("order_index")
  /// Snapshot of the barème at the moment the sim was composed, so later edits
  /// to the source question cannot retroactively change a graded paper.
  baremeSnapshot     Json?    @map("bareme_snapshot")
  maxScore           Decimal? @map("max_score") @db.Decimal(5, 2)

  examSimulation   ExamSimulation    @relation(fields: [examSimulationId], references: [id], onDelete: Cascade)
  question         Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  generatedProblem GeneratedProblem? @relation(fields: [generatedProblemId], references: [id], onDelete: SetNull)

  answer ExamAnswer?

  @@unique([examSimulationId, orderIndex])
  @@map("exam_simulation_questions")
}

model ExamAnswer {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examSimulationQuestionId String         @unique @map("exam_simulation_question_id") @db.Uuid
  submissionType           SubmissionType @map("submission_type")
  typedAnswer              String?        @map("typed_answer")
  photoUrl                 String?        @map("photo_url")
  ocrExtractedText         String?        @map("ocr_extracted_text")
  ocrConsistencyChecked    Boolean        @default(false) @map("ocr_consistency_checked")
  /// Set when the OCR self-consistency gate rejects the photo, so the student
  /// is told to re-shoot rather than being silently graded on garbage text.
  ocrConsistencyPassed     Boolean?       @map("ocr_consistency_passed")
  ocrConsistencyNotes      String?        @map("ocr_consistency_notes")
  /// [{ criterion, points_awarded, points_possible, justification, explanation }]
  /// `explanation` was added later; rows written before it are read with an
  /// empty one rather than discarded. See `baremeResultItemSchema`.
  baremeResult             Json?          @map("bareme_result")
  totalScore               Decimal?       @map("total_score") @db.Decimal(5, 2)
  maxScore                 Decimal?       @map("max_score") @db.Decimal(5, 2)
  submittedAt              DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  gradedAt                 DateTime?      @map("graded_at") @db.Timestamptz(6)

  examSimulationQuestion ExamSimulationQuestion @relation(fields: [examSimulationQuestionId], references: [id], onDelete: Cascade)

  @@map("exam_answers")
}

// ===========================================================================
// Attempts — the memory backbone
// ===========================================================================

model Attempt {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  /// The chapter the student was practising, which is not always where the
  /// question is filed. Null means the question's own chapter.
  chapterId          String?        @map("chapter_id") @db.Uuid
  questionId         String?        @map("question_id") @db.Uuid
  generatedProblemId String?        @map("generated_problem_id") @db.Uuid
  isCorrect          Boolean?       @map("is_correct")
  /// ADDITION — practice mode grades open questions against the barème, which
  /// requires keeping what the student actually wrote. Also what "Explain this"
  /// needs in order to explain *their* error rather than the generic solution.
  submittedAnswer    String?        @map("submitted_answer")
  score              Decimal?       @db.Decimal(5, 2)
  maxScore           Decimal?       @map("max_score") @db.Decimal(5, 2)
  /// Which criteria this answer earned, same shape as `exam_answers.bareme_result`:
  /// [{ criterion, points_awarded, points_possible, justification, explanation }]
  ///
  /// The marker always produced this and the row always dropped it, so a
  /// student could be told their total and never which part of the answer cost
  /// them. Null for MCQ, which has no criteria, and for every attempt written
  /// before this column existed — null means "no detail", never "scored zero".
  baremeResult       Json?          @map("bareme_result")
  timeTakenSeconds   Int?           @map("time_taken_seconds")
  context            AttemptContext
  attemptedAt        DateTime       @default(now()) @map("attempted_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  generatedProblem GeneratedProblem? @relation(fields: [generatedProblemId], references: [id], onDelete: Cascade)
  chatSessions     ChatSession[]
  chapter          Chapter?          @relation(fields: [chapterId], references: [id])

  @@index([userId, attemptedAt])
  @@index([questionId])
  @@map("attempts")
}

// ===========================================================================
// Progress & memory
// ===========================================================================

model ChapterMastery {
  userId        String   @map("user_id") @db.Uuid
  chapterId     String   @map("chapter_id") @db.Uuid
  masteryScore  Decimal  @default(0) @map("mastery_score") @db.Decimal(4, 3)
  attemptsCount Int      @default(0) @map("attempts_count")
  lastUpdated   DateTime @default(now()) @map("last_updated") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([userId, masteryScore])
  @@map("chapter_mastery")
}

/// SM-2 scheduling for one card, whichever kind of card it is.
///
/// The composite primary key became a surrogate id so that `question_id` could
/// be nullable: a card is now either a question the student has attempted or a
/// `GeneratedCard` written from their textbook, and exactly one of the two
/// columns is set. That is the same shape `Attempt` already uses to carry
/// either a question or a generated problem, so it is the pattern this schema
/// had rather than a new one.
///
/// Both unique constraints survive the change, which matters more than it
/// looks: `userId_questionId` is what every existing lookup and the SM-2 update
/// path resolve through, so none of that code had to move.
model FlashcardState {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  questionId      String?   @map("question_id") @db.Uuid
  generatedCardId String?   @map("generated_card_id") @db.Uuid
  easiness        Decimal   @default(2.5) @db.Decimal(3, 2)
  intervalDays    Int       @default(1) @map("interval_days")
  repetitions     Int       @default(0)
  dueDate         DateTime  @default(dbgenerated("CURRENT_DATE")) @map("due_date") @db.Date
  lastReviewedAt  DateTime? @map("last_reviewed_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  generatedCard GeneratedCard? @relation(fields: [generatedCardId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, generatedCardId])
  @@index([userId, dueDate])
  @@map("flashcard_state")
}

/// A revision card written from the textbook, for a chapter with no attempts
/// behind it yet.
///
/// Deliberately not a `Question`, and that is the whole point of the table.
/// The corpus of questions is the product's central claim — every one of them
/// comes off an official paper or out of the official programme, and nothing in
/// it was written by a model. Persisting these as questions with
/// `source_type = generated` would have been less code and would have made that
/// claim false, because a generated row would then be indistinguishable from a
/// real one to every query that reads the library.
///
/// So they live here instead: reachable only from the deck of the student who
/// asked for them, never from retrieval, never from an exam, never from
/// practice, and never counted in coverage or mastery.
///
/// The provenance is kept because it is what makes the card checkable. Every
/// card names the passage it was written from, and it was only kept if a second
/// model call could answer its front from that passage alone and agreed with
/// its back — see `fillFlashcardBank`.
model GeneratedCard {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId        String    @map("chapter_id") @db.Uuid
  /// The passage this was written from and checked against.
  sourceChunkId    String    @map("source_chunk_id") @db.Uuid
  /// Whose deck it belongs to. A card is generated on request, for one student.
  createdForUserId String    @map("created_for_user_id") @db.Uuid
  front            String
  back             String
  modelUsed        String?   @map("model_used")
  /// Set when a reviewer retires the card. A retired card stops being dealt but
  /// is not deleted — the review queue entry has to keep pointing somewhere.
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceChunk ContentChunk     @relation(fields: [sourceChunkId], references: [id], onDelete: Cascade)
  createdFor  User             @relation(fields: [createdForUserId], references: [id], onDelete: Cascade)
  cardStates  FlashcardState[]

  @@index([createdForUserId, createdAt])
  @@index([chapterId])
  @@map("generated_cards")
}

model ReadinessScore {
  userId            String   @map("user_id") @db.Uuid
  subjectId         String   @map("subject_id") @db.Uuid
  score             Decimal  @db.Decimal(4, 3)
  masteryComponent  Decimal? @map("mastery_component") @db.Decimal(4, 3)
  coverageComponent Decimal? @map("coverage_component") @db.Decimal(4, 3)
  trendComponent    Decimal? @map("trend_component") @db.Decimal(4, 3)
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId])
  @@map("readiness_scores")
}

// ===========================================================================
// Chat / RAG
// ===========================================================================

model ChatSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  questionId       String?  @map("question_id") @db.Uuid
  /// ADDITION — anchors the conversation to one marked attempt, so correction-key
  /// tutoring can be given the student's own answer and the marks it lost next
  /// to the official solution. Without it the tutor can only re-explain the
  /// model answer, which is the one thing the student can already read.
  attemptId        String?  @map("attempt_id") @db.Uuid
  /// Which subject this conversation is about, chosen before the first message.
  ///
  /// Null means "all of my subjects", which is what every conversation was
  /// before this column and what the general-help option still is. Set, it
  /// narrows retrieval to one subject and removes the cross-subject error
  /// `retrieval.ts` documents — a French literature passage beating the Arabic
  /// philosophy chapter that actually answers the question.
  subjectId        String?  @map("subject_id") @db.Uuid
  uploadedImageUrl String?  @map("uploaded_image_url")
  title            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  attempt  Attempt?  @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([subjectId])
  @@map("chat_sessions")
}

model ChatMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String         @map("session_id") @db.Uuid
  role           ChatRole
  content        String
  /// Null on user messages. Always set on assistant messages — an assistant
  /// message with no tier means the pipeline was bypassed, which is a bug.
  groundingTier  GroundingTier? @map("grounding_tier")
  citedSourceIds String[]       @map("cited_source_ids") @db.Uuid
  /// Top similarity score at the tier that fired; kept for eval harness runs
  /// and for tuning the 0.85 / 0.72 thresholds against real usage.
  topSimilarity  Decimal?       @map("top_similarity") @db.Decimal(5, 4)
  modelUsed      String?        @map("model_used")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ===========================================================================
// Personal (per-student, private) references
// ===========================================================================

model UserReference {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fileUrl       String   @map("file_url")
  fileName      String?  @map("file_name")
  extractedText String?  @map("extracted_text")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  embedding Unsupported("vector(1536)")?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_references")
}

model UserGrade {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  subjectId String?   @map("subject_id") @db.Uuid
  label     String?
  grade     Decimal?  @db.Decimal(5, 2)
  maxGrade  Decimal?  @map("max_grade") @db.Decimal(5, 2)
  date      DateTime? @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("user_grades")
}

// ===========================================================================
// Study planning
// ===========================================================================

model StudySession {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  chapterId       String?               @map("chapter_id") @db.Uuid
  title           String
  scheduledDate   DateTime              @map("scheduled_date") @db.Date
  durationMinutes Int?                  @map("duration_minutes")
  taskType        StudySessionTaskType? @map("task_type")
  source          StudySessionSource    @default(manual)
  status          StudySessionStatus    @default(planned)
  /// Set on a generated session: the one-line reason it was scheduled, shown to
  /// the student. A plan that cannot explain itself gets ignored.
  rationale       String?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledDate])
  @@map("study_sessions")
}

model UpcomingExam {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  subjectId String?  @map("subject_id") @db.Uuid
  examDate  DateTime @map("exam_date") @db.Date
  label     String?
  isBacExam Boolean  @default(false) @map("is_bac_exam")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, examDate])
  @@map("upcoming_exams")
}

model Todo {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  content         String
  linkedChapterId String?       @map("linked_chapter_id") @db.Uuid
  linkedAction    LinkedAction? @map("linked_action")
  isDone          Boolean       @default(false) @map("is_done")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedChapter Chapter? @relation(fields: [linkedChapterId], references: [id], onDelete: SetNull)

  @@index([userId, isDone])
  @@map("todos")
}

// ===========================================================================
// Admin / QA
// ===========================================================================

model Announcement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  body            String
  /// Null = all tracks.
  targetTrackId   String?  @map("target_track_id") @db.Uuid
  /// Null = all subjects.
  targetSubjectId String?  @map("target_subject_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targetTrack   Track?   @relation(fields: [targetTrackId], references: [id], onDelete: SetNull)
  targetSubject Subject? @relation(fields: [targetSubjectId], references: [id], onDelete: SetNull)
  author        User?    @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("announcements")
}

model ReviewQueueItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemType         ReviewItemType @map("item_type")
  itemId           String         @map("item_id") @db.Uuid
  flagReason       String?        @map("flag_reason")
  flaggedByUserId  String?        @map("flagged_by_user_id") @db.Uuid
  status           ReviewStatus   @default(pending)
  reviewedByUserId String?        @map("reviewed_by_user_id") @db.Uuid
  reviewNotes      String?        @map("review_notes")
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  flaggedBy  User? @relation("ReviewFlagger", fields: [flaggedByUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReviewResolver", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([itemType, itemId])
  @@map("review_queue")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String
  /// Where tapping the notification should land.
  href      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/// ADDITION — /admin/ingestion is specified as "trigger/monitor ingestion batch
/// jobs" but the plan has no table to monitor. Without this the admin page is
/// a button with nothing to show.
model IngestionJob {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           String
  subjectId      String?            @map("subject_id") @db.Uuid
  status         IngestionJobStatus @default(queued)
  sourceLabel    String?            @map("source_label")
  itemsTotal     Int                @default(0) @map("items_total")
  itemsProcessed Int                @default(0) @map("items_processed")
  itemsFailed    Int                @default(0) @map("items_failed")
  errorMessage   String?            @map("error_message")
  log            Json?
  triggeredBy    String?            @map("triggered_by") @db.Uuid
  startedAt      DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("ingestion_jobs")
}

/// One AI call, and what it cost. Written by the provider layer so no call site
/// can forget; read by the budget check before an expensive request runs.
model AiUsage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  /// Which feature spent it: chat, verify, marking, ocr, generation.
  kind              String
  model             String
  inputTokens       Int      @default(0) @map("input_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  /// Micro-dollars. Integer, because a month's bill is summed from these.
  costMicros        BigInt   @default(0) @map("cost_micros")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ai_usage")
}
